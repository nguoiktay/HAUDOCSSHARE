@model List<Documentshare.Models.Document>
@{
    ViewData["Title"] = "Quản lý tài liệu - Admin";
}

@functions {
    static string Ext(string e) => (e ?? "").ToLower().TrimStart('.');
    static string FmtSize(long b) {
        if (b == 0) return "—";
        string[] s = { "B", "KB", "MB", "GB" }; int i = 0; double v = b;
        while (v >= 1024 && i < s.Length - 1) { v /= 1024; i++; }
        return $"{v:0.#} {s[i]}";
    }
    static string FileIconCls(string e) => Ext(e) switch {
        "pdf" => "bi-file-pdf text-danger",
        "doc" or "docx" => "bi-file-word text-primary",
        "xls" or "xlsx" => "bi-file-excel text-success",
        "ppt" or "pptx" => "bi-file-ppt text-warning",
        "zip" or "rar" => "bi-file-zip text-warning",
        "png" or "jpg" or "jpeg" => "bi-file-image text-info",
        _ => "bi-file-earmark text-secondary"
    };
}

<style>
    .admin-layout { display: flex; min-height: calc(100vh - 70px); }
    .admin-sidebar {
        width: 240px; min-width: 240px;
        background: rgba(8,12,28,0.95);
        border-right: 1px solid rgba(255,255,255,0.06);
        padding: 1.5rem 1rem;
        position: sticky; top: 70px; height: calc(100vh - 70px);
        overflow-y: auto;
    }
    .sidebar-brand {
        display: flex; align-items: center; gap: .6rem;
        padding: .5rem .75rem 1.25rem;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        margin-bottom: 1rem;
    }
    .sidebar-brand .brand-icon {
        width: 34px; height: 34px; border-radius: 9px;
        background: linear-gradient(135deg,#ef4444,#dc2626);
        display:flex;align-items:center;justify-content:center;
        color:white;font-size:.95rem;flex-shrink:0;
    }
    .sidebar-brand .brand-name { font-weight:800;font-size:.95rem;color:#f1f5f9; }
    .sidebar-brand .brand-sub  { font-size:.68rem;color:#ef4444;font-weight:600;letter-spacing:.06em; }
    .sidebar-section { font-size:.65rem;font-weight:700;letter-spacing:.12em;color:#334155;padding:.5rem .75rem .25rem;text-transform:uppercase; }
    .sidebar-link {
        display:flex;align-items:center;gap:.6rem;padding:.55rem .75rem;
        border-radius:9px;color:#64748b;font-size:.875rem;font-weight:500;
        text-decoration:none;transition:all .2s;margin-bottom:2px;
    }
    .sidebar-link:hover { background:rgba(255,255,255,0.04);color:#f1f5f9; }
    .sidebar-link.active { background:rgba(239,68,68,0.12);color:#fb7185;border:1px solid rgba(239,68,68,0.2); }
    .admin-main { flex:1;padding:2rem;min-width:0; }

    .doc-table-wrap {
        background:rgba(15,23,42,0.8);border:1px solid rgba(255,255,255,0.06);
        border-radius:16px;overflow:hidden;
    }
    .doc-table { width:100%;border-collapse:collapse; }
    .doc-table th {
        background:rgba(0,0,0,0.3);padding:.875rem 1rem;
        text-align:left;font-size:.75rem;font-weight:700;
        color:#64748b;letter-spacing:.06em;border-bottom:1px solid rgba(255,255,255,0.06);
    }
    .doc-table td {
        padding:.875rem 1rem;border-bottom:1px solid rgba(255,255,255,0.04);
        vertical-align:middle;font-size:.875rem;color:#cbd5e1;
    }
    .doc-table tr:last-child td { border-bottom:none; }
    .doc-table tr:hover td { background:rgba(255,255,255,0.02); }

    .status-pill {
        display:inline-flex;align-items:center;gap:.3rem;
        padding:.2rem .6rem;border-radius:999px;font-size:.72rem;font-weight:700;
    }
    .status-pill.approved { background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.2);color:#34d399; }
    .status-pill.pending  { background:rgba(245,158,11,0.12);border:1px solid rgba(245,158,11,0.2);color:#fbbf24; }

    .btn-sm-action {
        padding:.3rem .7rem;border-radius:7px;font-size:.75rem;font-weight:600;
        border:none;cursor:pointer;transition:all .2s;text-decoration:none;
        display:inline-flex;align-items:center;gap:.25rem;
    }
    .btn-view-doc { background:rgba(99,102,241,0.12);color:#818cf8; }
    .btn-view-doc:hover { background:rgba(99,102,241,0.22);color:#a5b4fc; }
    .btn-approve-doc { background:rgba(16,185,129,0.12);color:#34d399; }
    .btn-approve-doc:hover { background:rgba(16,185,129,0.22); }
    .btn-delete-doc { background:rgba(244,63,94,0.1);color:#fb7185; }
    .btn-delete-doc:hover { background:rgba(244,63,94,0.2); }

    @@media (max-width:992px) {
        .doc-table th:nth-child(4), .doc-table td:nth-child(4) { display:none; }
    }
    @@media (max-width:768px) {
        .admin-sidebar { display:none; }
        .admin-main { padding:1rem; }
        .doc-table th:nth-child(3), .doc-table td:nth-child(3) { display:none; }
    }
</style>

<div class="admin-layout">
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon"><i class="bi bi-shield-fill"></i></div>
            <div>
                <div class="brand-name">Admin Panel</div>
                <div class="brand-sub">HAUDOCSSHARE</div>
            </div>
        </div>
        <div class="sidebar-section">Tổng quan</div>
        <a href="/Admin" class="sidebar-link"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <div class="sidebar-section" style="margin-top:.75rem;">Quản lý</div>
        <a href="/Admin/Documents" class="sidebar-link active"><i class="bi bi-file-earmark-text"></i> Tài liệu</a>
        <a href="/Admin/Users" class="sidebar-link"><i class="bi bi-people"></i> Người dùng</a>
        <div class="sidebar-section" style="margin-top:.75rem;">Hệ thống</div>
        <a href="/" class="sidebar-link"><i class="bi bi-house-door"></i> Trang chủ</a>
        <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
            @Html.AntiForgeryToken()
            <button type="submit" class="sidebar-link w-100 border-0 text-start" style="background:none;cursor:pointer;">
                <i class="bi bi-box-arrow-left"></i> Đăng xuất
            </button>
        </form>
    </aside>

    <main class="admin-main">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 text-white mb-4" role="alert" style="background:rgba(16,185,129,0.2); border: 1px solid rgba(16,185,129,0.3) !important;">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 text-white mb-4" role="alert" style="background:rgba(244,63,94,0.2); border: 1px solid rgba(244,63,94,0.3) !important;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
            <div>
                <h1 class="fw-bold mb-1" style="font-size:1.6rem;letter-spacing:-.5px;color:var(--text-primary);">
                    <i class="bi bi-file-earmark-text me-2" style="color:#fb7185;"></i>Quản lý tài liệu
                </h1>
                <p class="mb-0" style="color:#64748b;font-size:.875rem;">Kiểm duyệt và quản lý danh sách tài liệu chia sẻ</p>
            </div>
            <span style="margin-left:auto;background:rgba(251,113,133,0.1);border:1px solid rgba(251,113,133,0.2);color:#fb7185;border-radius:999px;padding:.25rem 1rem;font-size:.8rem;font-weight:700;">
                @Model.Count tài liệu
            </span>
        </div>

        <div class="doc-table-wrap">
            <table class="doc-table">
                <thead>
                    <tr>
                        <th>TÀI LIỆU</th>
                        <th>DANH MỤC / TRÌNH ĐỘ</th>
                        <th>TÁC GIẢ / NGÀY ĐĂNG</th>
                        <th>THỐNG KÊ</th>
                        <th>TRẠNG THÁI</th>
                        <th>HÀNH ĐỘNG</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-start gap-2" style="max-width:320px;">
                                <i class="bi @FileIconCls(d.FileExtension) fs-3 mt-1" style="flex-shrink:0;"></i>
                                <div>
                                    <div style="font-weight:600;color:var(--text-primary);line-height:1.2;margin-bottom:.2rem;">
                                        @d.Title
                                    </div>
                                    <div style="font-size:.72rem;color:#475569;">
                                        @Ext(d.FileExtension).ToUpper() · @FmtSize(d.FileSize)
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div>
                                <span style="background:rgba(99,102,241,0.12);color:#818cf8;border-radius:999px;padding:.1rem .5rem;font-size:.7rem;font-weight:600;display:inline-block;margin-bottom:.2rem;">
                                    @(d.Category?.Name ?? "Khác")
                                </span>
                                <div style="font-size:.75rem;color:#64748b;"><i class="bi bi-bar-chart-steps me-1"></i>@d.Level</div>
                            </div>
                        </td>
                        <td>
                            <div style="font-weight:500;color:#cbd5e1;">@d.Author</div>
                            <div style="font-size:.75rem;color:#64748b;">@d.UploadDate.ToString("dd/MM/yyyy HH:mm")</div>
                        </td>
                        <td>
                            <div style="font-size:.8rem;color:#94a3b8;">
                                <div><i class="bi bi-eye me-1"></i>@d.ViewCount lượt xem</div>
                                <div><i class="bi bi-download me-1"></i>@d.DownloadCount lượt tải</div>
                            </div>
                        </td>
                        <td>
                            <span class="status-pill @(d.IsApproved ? "approved" : "pending")">
                                <i class="bi @(d.IsApproved ? "bi-check-circle-fill" : "bi-clock-history")"></i>
                                @(d.IsApproved ? "Đã duyệt" : "Chờ duyệt")
                            </span>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <a asp-controller="Document" asp-action="Details" asp-route-id="@d.Id" class="btn-sm-action btn-view-doc" target="_blank">
                                    <i class="bi bi-eye"></i>Xem
                                </a>
                                @if (!d.IsApproved)
                                {
                                    <form asp-action="Approve" method="post" style="margin:0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <button type="submit" class="btn-sm-action btn-approve-doc">
                                            <i class="bi bi-check2"></i>Duyệt
                                        </button>
                                    </form>
                                }
                                <form asp-action="DeleteDocument" method="post" style="margin:0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <button type="submit" class="btn-sm-action btn-delete-doc"
                                            onclick="return confirm('Bạn chắc chắn muốn xóa tài liệu «@d.Title»?')">
                                        <i class="bi bi-trash"></i>Xóa
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </main>
</div>
