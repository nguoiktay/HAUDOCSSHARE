@model List<Documentshare.Models.User>
@{
    ViewData["Title"] = "Quản lý người dùng - Admin";
    var currentUserId = Context.Session.GetInt32("UserId");
}

<style>
    .admin-layout { display: flex; min-height: calc(100vh - 70px); }
    .admin-sidebar {
        width: 240px; min-width: 240px;
        background: rgba(8,12,28,0.95);
        border-right: 1px solid rgba(255,255,255,0.06);
        padding: 1.5rem 1rem;
        position: sticky; top: 70px; height: calc(100vh - 70px);
        overflow-y: auto;
    }
    .sidebar-brand {
        display: flex; align-items: center; gap: .6rem;
        padding: .5rem .75rem 1.25rem;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        margin-bottom: 1rem;
    }
    .sidebar-brand .brand-icon {
        width: 34px; height: 34px; border-radius: 9px;
        background: linear-gradient(135deg,#ef4444,#dc2626);
        display:flex;align-items:center;justify-content:center;
        color:white;font-size:.95rem;flex-shrink:0;
    }
    .sidebar-brand .brand-name { font-weight:800;font-size:.95rem;color:#f1f5f9; }
    .sidebar-brand .brand-sub  { font-size:.68rem;color:#ef4444;font-weight:600;letter-spacing:.06em; }
    .sidebar-section { font-size:.65rem;font-weight:700;letter-spacing:.12em;color:#334155;padding:.5rem .75rem .25rem;text-transform:uppercase; }
    .sidebar-link {
        display:flex;align-items:center;gap:.6rem;padding:.55rem .75rem;
        border-radius:9px;color:#64748b;font-size:.875rem;font-weight:500;
        text-decoration:none;transition:all .2s;margin-bottom:2px;
    }
    .sidebar-link:hover { background:rgba(255,255,255,0.04);color:#f1f5f9; }
    .sidebar-link.active { background:rgba(239,68,68,0.12);color:#fb7185;border:1px solid rgba(239,68,68,0.2); }
    .admin-main { flex:1;padding:2rem;min-width:0; }

    .user-table-wrap {
        background:rgba(15,23,42,0.8);border:1px solid rgba(255,255,255,0.06);
        border-radius:16px;overflow:hidden;
    }
    .user-table { width:100%;border-collapse:collapse; }
    .user-table th {
        background:rgba(0,0,0,0.3);padding:.875rem 1rem;
        text-align:left;font-size:.75rem;font-weight:700;
        color:#64748b;letter-spacing:.06em;border-bottom:1px solid rgba(255,255,255,0.06);
    }
    .user-table td {
        padding:.875rem 1rem;border-bottom:1px solid rgba(255,255,255,0.04);
        vertical-align:middle;font-size:.875rem;color:#cbd5e1;
    }
    .user-table tr:last-child td { border-bottom:none; }
    .user-table tr:hover td { background:rgba(255,255,255,0.02); }

    .avatar {
        width:38px;height:38px;border-radius:10px;
        background:linear-gradient(135deg,#6366f1,#22d3ee);
        display:inline-flex;align-items:center;justify-content:center;
        color:white;font-weight:700;font-size:.9rem;flex-shrink:0;
    }
    .avatar.admin-avatar { background:linear-gradient(135deg,#ef4444,#f97316); }

    .role-pill {
        display:inline-flex;align-items:center;gap:.35rem;
        padding:.2rem .7rem;border-radius:999px;font-size:.72rem;font-weight:700;
    }
    .role-pill.admin { background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.25);color:#fb7185; }
    .role-pill.user  { background:rgba(99,102,241,0.12);border:1px solid rgba(99,102,241,0.2);color:#818cf8; }

    .status-dot {
        width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:.35rem;
    }
    .status-dot.active   { background:#34d399;box-shadow:0 0 6px #34d399; }
    .status-dot.inactive { background:#ef4444; }

    .btn-sm-action {
        padding:.3rem .7rem;border-radius:7px;font-size:.75rem;font-weight:600;
        border:none;cursor:pointer;transition:all .2s;
    }
    .btn-make-admin { background:rgba(239,68,68,0.12);color:#fb7185; }
    .btn-make-admin:hover { background:rgba(239,68,68,0.22); }
    .btn-make-user  { background:rgba(99,102,241,0.12);color:#818cf8; }
    .btn-make-user:hover  { background:rgba(99,102,241,0.22); }
    .btn-lock   { background:rgba(245,158,11,0.12);color:#fbbf24; }
    .btn-lock:hover   { background:rgba(245,158,11,0.22); }
    .btn-unlock { background:rgba(16,185,129,0.12);color:#34d399; }
    .btn-unlock:hover { background:rgba(16,185,129,0.22); }

    @@media (max-width:768px) {
        .admin-sidebar { display:none; }
        .admin-main { padding:1rem; }
        .user-table th:nth-child(4), .user-table td:nth-child(4) { display:none; }
    }
</style>

<div class="admin-layout">
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon"><i class="bi bi-shield-fill"></i></div>
            <div>
                <div class="brand-name">Admin Panel</div>
                <div class="brand-sub">DOCSHARE</div>
            </div>
        </div>
        <div class="sidebar-section">Tổng quan</div>
        <a href="/Admin" class="sidebar-link"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <div class="sidebar-section" style="margin-top:.75rem;">Quản lý</div>
        <a href="/Admin/Documents" class="sidebar-link"><i class="bi bi-file-earmark-text"></i> Tài liệu</a>
        <a href="/Admin/Users" class="sidebar-link active"><i class="bi bi-people"></i> Người dùng</a>
        <div class="sidebar-section" style="margin-top:.75rem;">Hệ thống</div>
        <a href="/" class="sidebar-link"><i class="bi bi-house-door"></i> Trang chủ</a>
        <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
            @Html.AntiForgeryToken()
            <button type="submit" class="sidebar-link w-100 border-0 text-start" style="background:none;cursor:pointer;">
                <i class="bi bi-box-arrow-left"></i> Đăng xuất
            </button>
        </form>
    </aside>

    <main class="admin-main">
        <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
            <div>
                <h1 class="fw-bold mb-1" style="font-size:1.6rem;letter-spacing:-.5px;color:var(--text-primary);">
                    <i class="bi bi-people me-2" style="color:#22d3ee;"></i>Quản lý người dùng
                </h1>
                <p class="mb-0" style="color:#64748b;font-size:.875rem;">Phân quyền và quản lý tài khoản thành viên</p>
            </div>
            <span style="margin-left:auto;background:rgba(34,211,238,0.1);border:1px solid rgba(34,211,238,0.2);color:#22d3ee;border-radius:999px;padding:.25rem 1rem;font-size:.8rem;font-weight:700;">
                @Model.Count tài khoản
            </span>
        </div>

        <div class="user-table-wrap">
            <table class="user-table">
                <thead>
                    <tr>
                        <th>NGƯỜI DÙNG</th>
                        <th>EMAIL</th>
                        <th>VAI TRÒ</th>
                        <th>NGÀY TẠO</th>
                        <th>TRẠNG THÁI</th>
                        <th>HÀNH ĐỘNG</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var u in Model)
                {
                    var isMe = u.Id == currentUserId;
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar @(u.Role == "Admin" ? "admin-avatar" : "")">
                                    @(u.DisplayName.Length > 0 ? u.DisplayName[0].ToString().ToUpper() : "?")
                                </div>
                                <div>
                                    <div style="font-weight:600;color:var(--text-primary);">
                                        @u.DisplayName
                                        @if (isMe) { <span style="font-size:.7rem;color:#64748b;">(bạn)</span> }
                                    </div>
                                    <div style="font-size:.75rem;color:#64748b;">@@@u.Username</div>
                                </div>
                            </div>
                        </td>
                        <td style="color:#94a3b8;">@u.Email</td>
                        <td>
                            <span class="role-pill @(u.Role == "Admin" ? "admin" : "user")">
                                <i class="bi @(u.Role == "Admin" ? "bi-shield-fill" : "bi-person-fill")"></i>
                                @(u.Role == "Admin" ? "Admin" : "Thành viên")
                            </span>
                        </td>
                        <td style="color:#64748b;font-size:.8rem;">@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="status-dot @(u.IsActive ? "active" : "inactive")"></span>
                            <span style="font-size:.8rem;color:@(u.IsActive ? "#34d399" : "#fb7185");">
                                @(u.IsActive ? "Hoạt động" : "Bị khóa")
                            </span>
                        </td>
                        <td>
                            @if (!isMe)
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @if (u.Role == "User")
                                    {
                                        <form asp-action="SetRole" method="post" style="margin:0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <input type="hidden" name="role" value="Admin" />
                                            <button type="submit" class="btn-sm-action btn-make-admin"
                                                    onclick="return confirm('Thăng @u.DisplayName lên Admin?')">
                                                <i class="bi bi-shield-plus me-1"></i>Thăng Admin
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="SetRole" method="post" style="margin:0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <input type="hidden" name="role" value="User" />
                                            <button type="submit" class="btn-sm-action btn-make-user"
                                                    onclick="return confirm('Hạ @u.DisplayName xuống Thành viên?')">
                                                <i class="bi bi-person-dash me-1"></i>Hạ xuống
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="ToggleUser" method="post" style="margin:0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button type="submit"
                                                class="btn-sm-action @(u.IsActive ? "btn-lock" : "btn-unlock")"
                                                onclick="return confirm('@(u.IsActive ? "Khóa" : "Mở khóa") tài khoản @u.DisplayName?')">
                                            <i class="bi @(u.IsActive ? "bi-lock" : "bi-unlock") me-1"></i>
                                            @(u.IsActive ? "Khóa" : "Mở khóa")
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span style="color:#334155;font-size:.8rem;font-style:italic;">Tài khoản của bạn</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </main>
</div>
