@model Documentshare.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập - DocShare";
    Layout = "_Layout";
}

<style>
    .auth-wrapper {
        min-height: calc(100vh - 70px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        background: radial-gradient(ellipse at 20% 50%, rgba(99,102,241,0.08) 0%, transparent 60%),
                    radial-gradient(ellipse at 80% 20%, rgba(34,211,238,0.06) 0%, transparent 50%);
    }
    .auth-card {
        width: 100%;
        max-width: 440px;
        background: rgba(15,23,42,0.85);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 2.5rem;
        box-shadow: 0 25px 60px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.03);
        backdrop-filter: blur(20px);
    }
    .auth-logo { text-align: center; margin-bottom: 2rem; }
    .auth-logo .logo-icon {
        width: 64px; height: 64px; border-radius: 16px;
        background: linear-gradient(135deg, #6366f1, #22d3ee);
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 1.75rem; color: white; margin-bottom: 1rem;
        box-shadow: 0 8px 20px rgba(99,102,241,0.4);
    }
    .auth-title { font-size: 1.5rem; font-weight: 800; color: #f1f5f9; margin-bottom: .25rem; }
    .auth-sub   { color: #64748b; font-size: .875rem; }
    .form-label-custom {
        color: #94a3b8; font-size: .8125rem; font-weight: 600;
        letter-spacing: .04em; margin-bottom: .4rem;
    }
    .form-control-custom {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px; color: #f1f5f9;
        padding: .75rem 1rem; font-size: .9375rem;
        transition: all .2s; width: 100%;
    }
    .form-control-custom:focus {
        outline: none; border-color: rgba(99,102,241,0.6);
        background: rgba(99,102,241,0.05);
        box-shadow: 0 0 0 3px rgba(99,102,241,0.15); color: #f1f5f9;
    }
    .form-control-custom::placeholder { color: #475569; }
    .input-icon-wrap { position: relative; }
    .input-icon-wrap .input-icon {
        position: absolute; left: .875rem; top: 50%; transform: translateY(-50%);
        color: #475569; font-size: 1rem; pointer-events: none;
    }
    .input-icon-wrap .form-control-custom { padding-left: 2.5rem; }
    .toggle-pw {
        position: absolute; right: .875rem; top: 50%; transform: translateY(-50%);
        background: none; border: none; color: #475569; cursor: pointer;
        padding: 0; font-size: 1rem;
    }
    .toggle-pw:hover { color: #818cf8; }
    .input-icon-wrap .form-control-custom.has-toggle { padding-right: 2.5rem; }

    .btn-auth {
        width: 100%; padding: .875rem; border-radius: 12px; border: none;
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        color: white; font-weight: 700; font-size: 1rem;
        letter-spacing: .02em; cursor: pointer; transition: all .25s;
        box-shadow: 0 4px 15px rgba(99,102,241,0.4);
    }
    .btn-auth:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(99,102,241,0.5); }
    .btn-auth:active { transform: translateY(0); }

    .remember-row {
        display: flex; align-items: center; gap: .5rem;
        color: #64748b; font-size: .875rem; margin-bottom: 1.5rem;
    }
    .remember-row input[type=checkbox] {
        width: 16px; height: 16px; accent-color: #6366f1; cursor: pointer;
    }

    .auth-divider {
        text-align: center; color: #334155; font-size: .8125rem;
        margin: 1.25rem 0; position: relative;
    }
    .auth-divider::before, .auth-divider::after {
        content: ''; position: absolute; top: 50%; height: 1px;
        background: rgba(255,255,255,0.07); width: calc(50% - 40px);
    }
    .auth-divider::before { left: 0; }
    .auth-divider::after  { right: 0; }

    .auth-link-row { text-align: center; color: #64748b; font-size: .875rem; }
    .auth-link-row a { color: #818cf8; font-weight: 600; text-decoration: none; }
    .auth-link-row a:hover { color: #a5b4fc; }
    .field-error { color: #fb7185; font-size: .775rem; margin-top: .25rem; }

    .demo-info {
        background: rgba(99,102,241,0.08);
        border: 1px solid rgba(99,102,241,0.2);
        border-radius: 10px; padding: .875rem 1rem;
        margin-bottom: 1.5rem; font-size: .8125rem; color: #94a3b8;
    }
    .demo-info strong { color: #818cf8; }
</style>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo">
            <div class="logo-icon"><i class="bi bi-journal-bookmark-fill"></i></div>
            <div class="auth-title">Chào mừng trở lại</div>
            <div class="auth-sub">Đăng nhập để tiếp tục với DocShare</div>
        </div>



        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                if (!string.IsNullOrEmpty(err.ErrorMessage))
                {
                    <div class="field-error mb-2"><i class="bi bi-exclamation-circle me-1"></i>@err.ErrorMessage</div>
                }
            }
        }

        <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label-custom">TÊN ĐĂNG NHẬP / EMAIL</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-person input-icon"></i>
                    <input asp-for="UsernameOrEmail"
                           class="form-control-custom"
                           placeholder="Username hoặc email"
                           autocomplete="username" autofocus />
                </div>
                <span asp-validation-for="UsernameOrEmail" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label class="form-label-custom">MẬT KHẨU</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-lock input-icon"></i>
                    <input asp-for="Password" id="loginPw"
                           class="form-control-custom has-toggle"
                           placeholder="Nhập mật khẩu"
                           autocomplete="current-password" />
                    <button type="button" class="toggle-pw" onclick="togglePw()">
                        <i class="bi bi-eye" id="pwEyeIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="remember-row">
                <input asp-for="RememberMe" id="rememberMe" />
                <label for="rememberMe" style="cursor:pointer;">Ghi nhớ đăng nhập trong 30 ngày</label>
            </div>

            <button type="submit" class="btn-auth">
                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
            </button>
        </form>

        <div class="auth-divider">chưa có tài khoản?</div>
        <div class="auth-link-row">
            <a asp-controller="Account" asp-action="Register">
                <i class="bi bi-person-plus me-1"></i>Tạo tài khoản miễn phí
            </a>
        </div>
    </div>
</div>

@section Scripts {
<script>
function togglePw() {
    const inp = document.getElementById('loginPw');
    const ico = document.getElementById('pwEyeIcon');
    if (inp.type === 'password') {
        inp.type = 'text';
        ico.className = 'bi bi-eye-slash';
    } else {
        inp.type = 'password';
        ico.className = 'bi bi-eye';
    }
}
</script>
}
