@model Documentshare.Models.Document
@{
    ViewData["Title"] = "Đăng tài liệu - HAUDOCSSHARE";
    var cats = ViewBag.Categories as List<Documentshare.Models.Category> ?? new();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <!-- Page Header -->
            <div class="mb-4">
                <h1 class="fw-bold" style="font-size:1.75rem;letter-spacing:-.5px;">
                    <i class="bi bi-cloud-arrow-up-fill me-2" style="color:var(--primary);"></i>Đăng tài liệu mới
                </h1>
                <p class="text-muted mb-0">Chia sẻ kiến thức với cộng đồng. Tài liệu sẽ hiển thị sau khi được Admin phê duyệt.</p>
            </div>

            <div class="glass-card">
                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert-danger-custom mb-4">
                            <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                        </div>
                    }

                    <input type="hidden" name="uploadType" id="uploadType" value="@(ViewBag.UploadType ?? "file")" />

                    <!-- Upload Type Toggle Tabs -->
                    <div class="d-flex gap-2 mb-4" id="uploadTypeToggle">
                        <button type="button" class="btn btn-premium w-50 py-2 btn-type" data-type="file" style="border-radius:var(--radius-sm); font-size:.9rem; font-weight:700;">
                            <i class="bi bi-file-earmark-arrow-up me-2"></i>Tải tệp từ máy
                        </button>
                        <button type="button" class="btn btn-premium-outline w-50 py-2 btn-type" data-type="link" style="border-radius:var(--radius-sm); font-size:.9rem; font-weight:700;">
                            <i class="bi bi-google me-2"></i>Link Video / Thư mục Google Drive
                        </button>
                    </div>
                    <!-- File Upload Zone -->
                    <div class="mb-4" id="fileUploadContainer">
                        <label class="fw-semibold text-secondary d-block mb-2" style="font-size:.8125rem;letter-spacing:.03em;text-transform:uppercase;">
                            <i class="bi bi-paperclip me-1"></i>Tệp tài liệu / Video
                        </label>
                        <div class="upload-zone" id="uploadZone">
                            <div class="upload-zone-icon"><i class="bi bi-cloud-upload-fill"></i></div>
                            <h5 class="fw-bold mb-1">Kéo thả tệp vào đây</h5>
                            <p class="text-muted small mb-3">PDF, DOCX, XLSX, ZIP, PNG, JPG, MP4, WebM... (tối đa 50MB)</p>
                            <input type="file" name="file" id="fileInput" class="form-control form-control-premium w-75 mx-auto" />
                        </div>
                        <div id="filePreview" class="mt-3 p-3 rounded d-none" style="background:rgba(99,102,241,0.07);border:1px solid rgba(99,102,241,0.2);">
                            <div class="d-flex align-items-center gap-3">
                                <i id="fIcon" class="bi bi-file-earmark fs-2 text-primary"></i>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div id="fName" class="fw-semibold text-truncate"></div>
                                    <small id="fSize" class="text-muted"></small>
                                </div>
                                <button type="button" id="removeFile" class="btn-close btn-close-white opacity-50"></button>
                            </div>
                        </div>
                    </div>

                    <!-- Google Drive Link Zone -->
                    <div class="mb-4 d-none" id="driveLinkContainer">
                        <label class="fw-semibold text-secondary d-block mb-2" style="font-size:.8125rem;letter-spacing:.03em;text-transform:uppercase;">
                            <i class="bi bi-link-45deg me-1"></i>Đường dẫn Video / Thư mục Google Drive
                        </label>
                        <input type="url" name="driveLink" id="driveLinkInput" class="form-control form-control-premium" value="@ViewBag.DriveLink" placeholder="Ví dụ: https://drive.google.com/drive/folders/1rB85HFVsm2CXSe-6qBFVYkuSaESkiQB8 hoặc link video" />
                        <span class="text-danger small">@Html.ValidationMessage("driveLink")</span>
                        <div class="mt-2 text-muted" style="font-size:.78rem;">
                            <i class="bi bi-info-circle me-1 text-info"></i>
                            Hãy đảm bảo video hoặc thư mục đã được chia sẻ ở chế độ <strong>"Bất kỳ ai có liên kết đều có thể xem"</strong> trên Google Drive.
                        </div>
                    </div>

                    <hr style="border-color:var(--card-border);margin:1.5rem 0;" />

                    <!-- Metadata -->
                    <div class="row g-3">
                        <!-- Title -->
                        <div class="col-12">
                            <label class="form-label fw-semibold" style="font-size:.8125rem;">
                                Tiêu đề tài liệu / Tên khóa học <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" class="form-control form-control-premium"
                                   placeholder="Ví dụ: Lập trình Python từ Zero - Hero (hoặc tên tài liệu/khóa học)" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Category + Level -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:.8125rem;">
                                Lĩnh vực / Danh mục <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CategoryId" class="form-select form-select-premium" required>
                                <option value="">— Chọn lĩnh vực —</option>
                                @foreach (var c in cats)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:.8125rem;">Cấp độ</label>
                            <select asp-for="Level" class="form-select form-select-premium">
                                <option value="Tất cả cấp độ">Tất cả cấp độ</option>
                                <option value="Cơ bản">Cơ bản — Người mới bắt đầu</option>
                                <option value="Trung cấp">Trung cấp — Đã có nền tảng</option>
                                <option value="Nâng cao">Nâng cao — Có kinh nghiệm</option>
                                <option value="Chuyên sâu">Chuyên sâu — Chuyên gia</option>
                            </select>
                        </div>

                        <!-- Author + Language -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:.8125rem;">Tác giả / Người đăng</label>
                            <input asp-for="Author" class="form-control form-control-premium" placeholder="Tên của bạn hoặc để trống" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:.8125rem;">Ngôn ngữ tài liệu</label>
                            <select asp-for="Language" class="form-select form-select-premium">
                                <option value="Tiếng Việt">🇻🇳 Tiếng Việt</option>
                                <option value="English">🇬🇧 English</option>
                                <option value="日本語">🇯🇵 日本語</option>
                                <option value="한국어">🇰🇷 한국어</option>
                                <option value="中文">🇨🇳 中文</option>
                                <option value="Français">🇫🇷 Français</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>

                        <!-- Source -->
                        <div class="col-12">
                            <label class="form-label fw-semibold" style="font-size:.8125rem;">Nguồn gốc / Xuất xứ</label>
                            <input asp-for="Source" class="form-control form-control-premium"
                                   placeholder="Ví dụ: Giáo trình Trường ĐH Bách khoa, Sách O'Reilly, v.v." />
                        </div>

                        <!-- Tags -->
                        <div class="col-12">
                            <label class="form-label fw-semibold" style="font-size:.8125rem;">Thẻ từ khóa</label>
                            <input asp-for="Tags" class="form-control form-control-premium"
                                   placeholder="python, lập-trình, machine-learning (phân cách bằng dấu phẩy)" />
                            <small class="text-muted">Giúp người dùng dễ tìm kiếm tài liệu hơn.</small>
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <label class="form-label fw-semibold" style="font-size:.8125rem;">Mô tả nội dung</label>
                            <textarea asp-for="Description" rows="4" class="form-control form-control-premium"
                                      placeholder="Tóm tắt nội dung, điểm nổi bật của tài liệu..."></textarea>
                        </div>
                    </div>

                    <!-- Notice -->
                    <div class="mt-4 p-3 rounded" style="background:rgba(245,158,11,0.06);border:1px solid rgba(245,158,11,0.15);">
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1 text-warning"></i>
                            Tài liệu của bạn sẽ được xem xét bởi đội ngũ quản trị trước khi hiển thị công khai.
                            Quá trình thường mất vài giờ.
                        </small>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3" style="border-top:1px solid var(--card-border);">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-premium-outline">
                            <i class="bi bi-x-circle me-1"></i>Hủy
                        </a>
                        <button type="submit" class="btn btn-premium px-4">
                            <i class="bi bi-send-fill me-1"></i>Gửi để duyệt
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const zone = document.getElementById('uploadZone');
const inp  = document.getElementById('fileInput');
const prev = document.getElementById('filePreview');
const fName= document.getElementById('fName');
const fSize= document.getElementById('fSize');
const fIcon= document.getElementById('fIcon');
const rem  = document.getElementById('removeFile');

function showFile(f){
    if(!f) return;
    const ext = f.name.split('.').pop().toLowerCase();
    const iconMap = {pdf:'bi-file-pdf text-danger',doc:'bi-file-word text-primary',docx:'bi-file-word text-primary',
        xls:'bi-file-excel text-success',xlsx:'bi-file-excel text-success',
        ppt:'bi-file-ppt text-warning',pptx:'bi-file-ppt text-warning',
        zip:'bi-file-zip text-warning',rar:'bi-file-zip text-warning',
        png:'bi-file-image text-info',jpg:'bi-file-image text-info',jpeg:'bi-file-image text-info',
        mp4:'bi-file-play text-info',webm:'bi-file-play text-info',ogg:'bi-file-play text-info'};
    fIcon.className = 'bi ' + (iconMap[ext] || 'bi-file-earmark text-secondary') + ' fs-2';
    fName.textContent = f.name;
    const kb = f.size/1024, mb = kb/1024;
    fSize.textContent = mb>=1 ? mb.toFixed(1)+' MB' : Math.round(kb)+' KB';
    prev.classList.remove('d-none');
    zone.style.opacity = '.5';
}

inp.addEventListener('change', e => { if(e.target.files[0]) showFile(e.target.files[0]); });
rem.addEventListener('click', () => { inp.value=''; prev.classList.add('d-none'); zone.style.opacity='1'; });

['dragenter','dragover'].forEach(ev => zone.addEventListener(ev, e=>{e.preventDefault();zone.classList.add('drag-active');}));
['dragleave','drop'].forEach(ev  => zone.addEventListener(ev, e=>{e.preventDefault();zone.classList.remove('drag-active');}));
zone.addEventListener('drop', e=>{
    const files = e.dataTransfer.files;
    if(files.length){ inp.files=files; showFile(files[0]); }
});

// Toggle between File and Google Drive Video Link
const uploadTypeVal = document.getElementById('uploadType').value;
const btnTypes = document.querySelectorAll('.btn-type');
const fileContainer = document.getElementById('fileUploadContainer');
const linkContainer = document.getElementById('driveLinkContainer');

function switchType(type) {
    document.getElementById('uploadType').value = type;
    btnTypes.forEach(btn => {
        if (btn.getAttribute('data-type') === type) {
            btn.classList.remove('btn-premium-outline');
            btn.classList.add('btn-premium');
        } else {
            btn.classList.remove('btn-premium');
            btn.classList.add('btn-premium-outline');
        }
    });
    if (type === 'link') {
        fileContainer.classList.add('d-none');
        linkContainer.classList.remove('d-none');
        document.getElementById('fileInput').removeAttribute('required');
        document.getElementById('driveLinkInput').setAttribute('required', 'required');
    } else {
        linkContainer.classList.add('d-none');
        fileContainer.classList.remove('d-none');
        document.getElementById('driveLinkInput').removeAttribute('required');
    }
}

btnTypes.forEach(btn => {
    btn.addEventListener('click', () => {
        switchType(btn.getAttribute('data-type'));
    });
});

switchType(uploadTypeVal);
</script>
}
